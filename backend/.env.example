ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME

# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_ME_WITH_GENERATED_KEY

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
APP_NAME=NkapSave
APP_VERSION=1.0.0
DEFAULT_COUNTRY_CODE=237

# Comma-separated list. Required (non-empty) when ENVIRONMENT=production.
ALLOWED_ORIGINS=http://localhost:3000

# ── Twilio (SMS + WhatsApp reminders) ────────────────────────
# Sign up: https://www.twilio.com/console
# WhatsApp sandbox/sender:  whatsapp:+14155238886  (Twilio sandbox)
REMINDER_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+15555550123
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Firebase Cloud Messaging (push notifications) ────────────
# Download a service-account JSON from the Firebase console and reference it here.
# Keep the file OUT of version control.
FCM_CREDENTIALS_PATH=./secrets/firebase-service-account.json
FCM_PROJECT_ID=your-firebase-project-id

# ── Fapshi (Mobile Money — MTN & Orange Cameroon) ────────────
# Sign up: https://fapshi.com → Dashboard → API Credentials
# Use FAPSHI_ENV=sandbox while testing; switch to production when live.
FAPSHI_ENV=sandbox
FAPSHI_COLLECTION_USER=your_collection_apiuser
FAPSHI_COLLECTION_KEY=FAK_your_collection_apikey
FAPSHI_PAYOUT_USER=your_payout_apiuser
FAPSHI_PAYOUT_KEY=FAK_your_payout_apikey

# ── NkapBot (Anthropic Claude) ───────────────────────────────
# Get a key at https://console.anthropic.com. Without it the chatbot replies
# with a graceful fallback message (retrieval still runs).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=1000

# ── NkapBot semantic RAG (embeddings) ────────────────────────
# How the chatbot retrieves financial-literacy passages by meaning.
#   auto   = Voyage if VOYAGE_API_KEY set → local lib if installed → lexical fallback
#   voyage | openai | local | hash  to pin a provider explicitly.
RAG_ENABLED=true
EMBEDDING_PROVIDER=auto
# Recommended: Voyage AI (multilingual, generous free tier).
# Get a key at https://dash.voyageai.com  — then EMBEDDING_PROVIDER stays "auto".
VOYAGE_API_KEY=
# Or use OpenAI embeddings instead:
OPENAI_API_KEY=
# Optional overrides:
# EMBEDDING_MODEL=voyage-3.5
# RAG_TOP_K=4
# RAG_MIN_SCORE=0.20
